{
    "name": "dns-clone",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "volta": {
        "node": "24.0.0"
    },
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "node scripts/load-deploy-env.cjs",
        "deploy:prod": "node scripts/load-deploy-env.cjs --env prod",
        "build:single": "node scripts/build-single-file.mjs",
        "cf-typegen": "wrangler types",
        "pretypecheck": "node scripts/ensure-worker-types.cjs",
        "typecheck": "tsc --noEmit",
        "pretypecheck:test": "node scripts/ensure-worker-types.cjs",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "check": "pnpm typecheck && pnpm typecheck:test && pnpm check:language && pnpm check:utf8 && pnpm lint && pnpm format:check && pnpm check:dashboard",
        "verify": "pnpm check && pnpm test",
        "check:dashboard": "node scripts/check-dashboard-script.mjs",
        "check:language": "node scripts/check-changed-language.mjs",
        "check:utf8": "node scripts/check-utf8.mjs",
        "prepare": "node scripts/install-git-hooks.cjs",
        "lint": "oxlint",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "merge:pr": "node scripts/merge-pr.mjs"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.6.0",
        "@types/node": "^24.19.2",
        "@vitest/coverage-istanbul": "5.1.0",
        "esbuild": "^0.28.2",
        "oxlint": "^1.91.0",
        "prettier": "^3.9.10",
        "typescript": "7.0.2",
        "vitest": "^5.1.0",
        "wrangler": "4.157.0"
    }
}
