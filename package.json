{
    "name": "dns-clone",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=22.0.0"
    },
    "volta": {
        "node": "24.0.0"
    },
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "node scripts/load-deploy-env.cjs",
        "predeploy": "node scripts/predeploy.cjs",
        "build:single": "node scripts/build-single-file.mjs",
        "cf-typegen": "wrangler types",
        "pretypecheck": "node scripts/ensure-worker-types.cjs",
        "typecheck": "tsc --noEmit",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check",
        "prepare": "node scripts/install-git-hooks.cjs",
        "lint": "oxlint",
        "format": "prettier --write --ignore-unknown .",
        "format:check": "prettier --check --ignore-unknown .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.23.0",
        "@vitest/coverage-istanbul": "4.1.11",
        "esbuild": "^0.28.2",
        "oxlint": "^1.89.0",
        "prettier": "^3.9.10",
        "typescript": "7.0.2",
        "vitest": "^4.1.0",
        "wrangler": "4.151.1"
    }
}
